generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  analyses            Analysis[]
  auditLogs           AuditLog[]
  conversationLogs    ConversationLog[]
  evidenceSources     EvidenceSource[]
  externalConnections ExternalConnection[]
  files               File[]
  geospatialChecks    GeospatialCheck[]
  hitlStatuses        HitlStatusRecord[]
  ocrResults          OcrResult[]
}

model File {
  id          String     @id @default(cuid())
  ownerId     String
  name        String
  storagePath String
  contentType String
  size        Int
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  owner       User       @relation(fields: [ownerId], references: [id])
  analyses    Analysis[] @relation("AnalysisToFile")

  @@index([ownerId])
  @@map("files")
}

model Analysis {
  id           String             @id @default(cuid())
  ownerId      String
  name         String
  data         Json?
  status       String             @default("queued")
  errorMessage String?
  metadata     Json?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  owner        User               @relation(fields: [ownerId], references: [id])
  hitlStatuses HitlStatusRecord[]
  files        File[]             @relation("AnalysisToFile")

  @@index([ownerId, status])
  @@index([status, createdAt])
  @@map("analyses")
}

model HitlStatusRecord {
  id         String   @id @default(cuid())
  analysisId String
  eventId    String
  status     String
  ownerId    String
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
  analysis   Analysis @relation(fields: [analysisId], references: [id])
  owner      User     @relation(fields: [ownerId], references: [id])

  @@unique([analysisId, eventId])
  @@index([analysisId])
  @@index([ownerId])
  @@map("hitl_statuses")
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  userId    String?
  details   Json?
  timestamp DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([action, timestamp])
  @@index([userId, timestamp])
  @@map("audit_logs")
}

model OcrResult {
  id               String   @id @default(cuid())
  ownerId          String
  fileName         String
  mimeType         String
  sourceType       String
  extractedText    String
  processingTimeMs Int
  sha256Hash       String
  caseId           String?
  createdAt        DateTime @default(now())
  owner            User     @relation(fields: [ownerId], references: [id])

  @@index([ownerId, createdAt])
  @@map("ocr_results")
}

model ConversationLog {
  id          String   @id @default(cuid())
  ownerId     String
  userMessage String
  history     Json?
  createdAt   DateTime @default(now())
  owner       User     @relation(fields: [ownerId], references: [id])

  @@index([ownerId, createdAt])
  @@map("conversation_logs")
}

model GeospatialCheck {
  id         String   @id @default(cuid())
  ownerId    String
  personName String?
  locationA  String?
  timeA      String?
  locationB  String?
  timeB      String?
  result     Json?
  createdAt  DateTime @default(now())
  owner      User     @relation(fields: [ownerId], references: [id])

  @@index([ownerId, createdAt])
  @@map("geospatial_checks")
}

model ExternalConnection {
  id                    String           @id @default(cuid())
  ownerId               String
  provider              String
  providerUserId        String?
  providerAccountName   String?
  encryptedAccessToken  String
  encryptedRefreshToken String?
  tokenExpiresAt        DateTime?
  scopes                String[]
  status                String           @default("active")
  metadata              Json?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  evidenceSources       EvidenceSource[]
  owner                 User             @relation(fields: [ownerId], references: [id])

  @@unique([ownerId, provider])
  @@index([ownerId, status])
  @@map("external_connections")
}

model EvidenceSource {
  id           String              @id @default(cuid())
  ownerId      String
  connectionId String?
  sourceType   String
  externalId   String
  name         String
  config       Json?
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  connection   ExternalConnection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  owner        User                @relation(fields: [ownerId], references: [id])

  @@index([connectionId])
  @@index([ownerId, sourceType])
  @@map("evidence_sources")
}
