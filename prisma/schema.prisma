generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  files     File[]
  analyses  Analysis[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model File {
  id          String     @id @default(cuid())
  ownerId     String
  owner       User       @relation(fields: [ownerId], references: [id])
  name        String
  storagePath String
  contentType String
  size        Int
  analyses    Analysis[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([ownerId])
  @@map("files")
}

model Analysis {
  id           String   @id @default(cuid())
  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id])
  name         String
  data         Json?
  status       String
  errorMessage String?
  files        File[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([ownerId, status])
  @@map("analyses")
}
