{
  "name": "forenzdetectiv",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"tsx watch server/index.ts\" \"vite\"",
    "predev": "node scripts/free-dev-ports.mjs 5175 5176 && node scripts/ensure-db.mjs",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "predev:api": "node scripts/free-dev-ports.mjs 5176 && node scripts/ensure-db.mjs",
    "dev:db": "prisma dev --name forenzdetectiv --detach",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sentry/react": "^10.70.0",
    "convex": "^1.44.0",
    "dotenv": "^17.4.2",
    "hono": "^4.13.2",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.23.0",
    "posthog-js": "^1.417.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.4.47",
    "prisma": "^7.9.1",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.23.12",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^5.4.8"
  },
  "allowScripts": {
    "prisma@7.9.1": true,
    "@prisma/engines@7.9.1": true,
    "esbuild@0.27.0": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true
  }
}
