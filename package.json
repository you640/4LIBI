{
  "name": "forenzdetectiv",
  "private": true,
  "version": "0.2.0-beta",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"tsx watch server/index.ts\" \"vite\"",
    "predev": "node scripts/free-dev-ports.mjs 5175 5176 && node scripts/ensure-db.mjs",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "predev:api": "node scripts/free-dev-ports.mjs 5176 && node scripts/ensure-db.mjs",
    "dev:db": "prisma dev --name forenzdetectiv --detach",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run --project unit --project api --project components",
    "test:unit": "vitest run --project unit",
    "test:api": "vitest run --project api",
    "test:components": "vitest run --project components",
    "test:integration": "vitest run --project integration",
    "pretest:integration": "node scripts/ensure-integration-db.mjs",
    "test:coverage": "vitest run --project unit --project api --project components --coverage",
    "test:ci": "vitest run --project unit --project api --project components --coverage",
    "test:e2e": "playwright test",
    "test:e2e:full": "playwright test --config=playwright.fullstack.config.ts",
    "pretest:all": "docker compose up -d postgres redis",
    "test:all": "npm run test && npm run test:integration && npm run test:e2e",
    "health-check": "node scripts/health-check.mjs",
    "test:mistral": "node scripts/test-mistral.mjs",
    "test:watch": "vitest",
    "clean:data": "node scripts/clean-all-data.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sentry/react": "^10.70.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.1.2",
    "dotenv": "^17.4.2",
    "hono": "^4.13.2",
    "idb": "^7.1.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsdom": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "express-rate-limit": "^8.6.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "postcss": "^8.4.47",
    "posthog-js": "^1.422.2",
    "prisma": "^7.9.1",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.23.12",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-window": "^7.4.1"
  },
  "allowScripts": {
    "prisma@7.9.1": true,
    "@prisma/engines@7.9.1": true,
    "esbuild@0.27.0": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true,
    "core-js@3.50.0": true,
    "msgpackr-extract@3.0.4": true
  }
}
