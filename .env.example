# ==========================================
# ForenzDetectiv / Alibi — AI Forenzná Platforma
# ==========================================

# === PostgreSQL (Prisma) ===
# Lokálna alebo remote Postgres databáza
DATABASE_URL="postgresql://user:password@localhost:5432/forenzdetectiv?schema=public"

# === Redis (BullMQ Job Queue) ===
# Vyžadované pre asynchrónne spracovanie PDF
# Nainštaluj: sudo apt install redis-server || docker run -p 6379:6379 redis
REDIS_URL="redis://localhost:6379"

# === Authentication ===
# JWT Secret pre tokeny (min. 32 znakov) - POVINNÉ
JWT_SECRET="tvoje-tajne-heslo-minimum-32-znakov"
# API Key pre autentifikáciu cez x-api-key header - POVINNÉ
API_KEY="tvoj-api-kluc"
# Povolené domény pre CORS (oddelené čiarkou) - POVINNÉ
ALLOWED_ORIGINS="http://localhost:5173,https://tvoja-domena.sk"
# Vypnúť autentifikáciu v developmente (default: enabled)
# ENABLE_AUTH=true

# === Mistral / Pixtral API (Sherlock AI) ===
# Získaj na https://console.mistral.ai/
# Model 1: mistral-large-latest (textová analýza, rozpory, chat)
# Model 2: pixtral-12b-2409 / pixtral-large-latest (OCR zo skenov a fotografií)
# MISTRAL_API_KEY — server-side (Hono API server/index.ts), nie v prehliadači - POVINNÉ
MISTRAL_API_KEY=""

# === Google Drive OAuth 2.0 ===
# Pre import dokumentov z Google Drive
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# === PostHog EU (Analytics) ===
VITE_POSTHOG_KEY=""
VITE_POSTHOG_HOST="https://eu.i.posthog.com"

# === Sentry (Error monitoring) ===
VITE_SENTRY_DSN=""
VITE_SENTRY_ENV="production"

# === Stripe (Monetizácia) ===
VITE_STRIPE_PUBLIC_KEY=""
