# === PostgreSQL (Prisma) ===
DATABASE_URL="postgresql://forenz:forenz@localhost:5432/forenzdetectiv?schema=public"

# === Mistral / Pixtral API (Sherlock AI) ===
# Získaj na https://console.mistral.ai/
# MISTRAL_API_KEY — iba na Node API (server/index.ts), nie v prehliadači
MISTRAL_API_KEY=
# VITE_MISTRAL_API_KEY — už nie je potrebný na analýzu (ostáva len pre starý client-side tok)
VITE_MISTRAL_API_KEY=

# === PostHog EU (Analytics — Issue #3) ===
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# === Sentry (Error monitoring — Issue #2) ===
VITE_SENTRY_DSN=
VITE_SENTRY_ENV=production

# === Stripe (Monetizácia — Issue S5.1) ===
VITE_STRIPE_PUBLIC_KEY=

# === Convex ===
# Nastaví sa automaticky cez `npx convex dev`
VITE_CONVEX_URL=
