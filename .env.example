# === Mistral / Pixtral API (Sherlock AI) ===
# Získaj na https://console.mistral.ai/
# MISTRAL_API_KEY — pre Convex backend (server-side, v Convex env)
MISTRAL_API_KEY=
# VITE_MISTRAL_API_KEY — pre frontend (client-side, v .env)
# POZOR: kľúč bude viditeľný v browseri — používaj len pre vývoj/demo
# V produkcii používaj Convex backend (analyze.ts node action)
VITE_MISTRAL_API_KEY=

# === PostHog EU (Analytics — Issue #3) ===
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# === Sentry (Error monitoring — Issue #2) ===
VITE_SENTRY_DSN=
VITE_SENTRY_ENV=production

# === Stripe (Monetizácia — Issue S5.1) ===
VITE_STRIPE_PUBLIC_KEY=

# === Convex ===
# Nastaví sa automaticky cez `npx convex dev`
VITE_CONVEX_URL=
