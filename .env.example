# ==========================================
# ForenzDetectiv / Alibi — AI Forenzná Platforma
# ==========================================
# Skopíruj do .env a doplň VLASTNÉ hodnoty. Sem nedávaj reálne kľúče.

# === PostgreSQL (Prisma) — POVINNÉ ===
# PostgreSQL connection string (Railway Cloud alebo vlastný server)
DATABASE_URL="postgresql://user:password@host:port/database?schema=public"

# === Redis (BullMQ Job Queue) — POVINNÉ pre Sherlock frontu ===
# Redis connection string (Railway Cloud alebo vlastný server)
REDIS_URL="redis://default:password@host:port"
# Voliteľné: nastavte iba pre procesy, ktoré zdieľajú ten istý upload filesystem.
# Inak sa bezpečný názov fronty odvodí automaticky z hostiteľa a pracovného adresára.
# ANALYSIS_QUEUE_NAME="analysis_production"

# === Authentication ===
# JWT Secret pre tokeny (min. 32 znakov) — POVINNÉ keď auth beží
JWT_SECRET="tvoje-tajne-heslo-minimum-32-znakov"
# API Key pre autentifikáciu cez x-api-key header — POVINNÉ keď auth beží
API_KEY="tvoj-api-kluc"
# Povolené domény pre CORS (oddelené čiarkou). Nikdy sa nevracia * spolu s credentials.
# Produkcia: pridaj Vercel origin, ak frontend volá Railway priamo (VITE_API_URL).
# Same-origin cez vercel.json rewrite CORS nepotrebuje.
# Produkcia (Vercel rewrite je same-origin; tieto originy treba, ak frontend volá Railway priamo):
# ALLOWED_ORIGINS="https://forenzdetectiv-web.vercel.app,https://forenzdetectiv.sk,https://www.forenzdetectiv.sk"
ALLOWED_ORIGINS="http://localhost:5175,http://127.0.0.1:5175,http://localhost:5173,https://forenzdetectiv-web.vercel.app"
#
# ENABLE_AUTH — fail-closed.
# Auth je ZAPNUTÁ, kým nie je EXPLICITNE ENABLE_AUTH=false.
# ENABLE_AUTH=false  → len lokálny vývoj (x-owner-id / dev_local_user). NIKDY v produkcii.
# ENABLE_AUTH=true   → rovnaké ako vynechať premennú: vyžaduje JWT Bearer alebo x-api-key.
# ENABLE_AUTH=false

# === Linear — jediný povolený dôkazný repozitár (server-only) ===
# Personal API key z Linear Settings → API.
# Bez kľúča sa analýza troch vyšetrovacích otázok ZASTAVÍ (fail-closed).
LINEAR_API_KEY=""
# Povolený project ID. Ak prázdne, použije sa UBOK výpovede a spisové informácie.
# LINEAR_PROJECT_ID="cf930d36-765a-4e6f-b170-2d8a2da83f0b"

# === Mistral / Pixtral API (Sherlock AI) — server-only ===
# Získaj na https://console.mistral.ai/
# Model 1: mistral-large-latest (textová analýza, rozpory, chat)
# Model 2: pixtral-12b-2409 / pixtral-large-latest (OCR zo skenov a fotografií)
# MISTRAL_API_KEY — Hono server (server/index.ts). NIE VITE_*, nie prehliadač. POVINNÉ pre reálnu analýzu.
MISTRAL_API_KEY=""
# Záložný kľúč, ak hlavný vráti 401/402 (Forenz /analyze). Server-only, prázdne = nepoužíva sa.
MISTRAL_BACKUP_API_KEY=""
# OCR kľúč (server-only). Ak prázdny, OCR použiť MISTRAL_API_KEY / MISTRAL_BACKUP_API_KEY.
MISTRAL_OCR_API_KEY=""

# === Frontend → API ===
# Prázdne = same-origin /api (lokálne Vite proxy; na Verceli rewrite na Railway)
# VITE_API_URL="https://api-production-3466e.up.railway.app"

# === PostHog Analytics (EU) ===
# North Star: contradiction_viewed — pozri docs/LOOKER_POSTHOG.md
VITE_POSTHOG_KEY=""
VITE_POSTHOG_HOST="https://eu.i.posthog.com"

# === Google Drive OAuth 2.0 ===
# Pre import dokumentov z Google Drive
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# === Sentry (Error monitoring & Source Maps) ===
# Frontend (Vercel): VITE_SENTRY_DSN + VITE_SENTRY_ENV=staging|production
# Bez DSN = tichý no-op. Pozri docs/DEPLOY.md § Sentry.
# 1. DSN — URL pre odosielanie chýb (Settings > Projects > Váš Projekt > Client Keys DSN)
VITE_SENTRY_DSN=""
VITE_SENTRY_ENV="development"
# 2. Auth Token — osobný token na upload source maps (z Settings > Account > API > Personal Tokens)
SENTRY_AUTH_TOKEN=""

# === Stripe (Monetizácia) ===
VITE_STRIPE_PUBLIC_KEY=""

# === External Connections (GitHub / Linear OAuth) — server-only ===
# Verejná URL frontendu. OAuth callback ide cez Vercel rewrite na Railway.
APP_BASE_URL="https://forenzdetectiv-web.vercel.app"
# SESSION_SECRET je voliteľný alias pre podpis OAuth state (inak JWT_SECRET).
SESSION_SECRET=""
# AES-256-GCM kľúč na uloženie OAuth tokenov. Generate:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=""
LINEAR_CLIENT_ID=""
LINEAR_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
