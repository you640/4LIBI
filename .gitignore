# ==========================================
# ForenzDetectiv — .gitignore
# ==========================================

# --- Dependencies ---
node_modules/

# --- Build output ---
dist/
build/
*.tsbuildinfo

# --- Prisma generated client ---
generated/

# --- Uploaded case files (runtime) ---
uploads/
!uploads/.gitkeep

# --- Environment & secrets ---
.env
.env.*
!.env.example
.env.backup
.env.local
.env.*.local

# --- Test & coverage artifacts ---
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/
.vitest/

# --- Archives & temp dumps ---
tests.zip
*.zip
!public/**/*.zip

# --- Deploy / hosting ---
.vercel
.railway

# --- Editor & IDE ---
.vscode/
.idea/
*.swp
*.swo
*.code-workspace

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Sensitive local documents (test spisy, PDF) ---
docs/*.pdf
docs/**/*.pdf

# --- Legacy (Convex — no longer used) ---
.convex/

.railway-beta-api-key.txt
.railway-status-tmp.json
